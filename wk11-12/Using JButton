import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Insets;
import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JTextField;

public class SalaryCalculator {
    public static void main(String[] args) {
        JLabel wageLabel = new JLabel("Hourly wage:");
        JLabel salaryLabel = new JLabel("Yearly salary:");

       
        JTextField wageField = new JTextField("0", 10);
        JTextField salaryField = new JTextField("0", 10);
        salaryField.setEditable(false);

     
        JButton calculateButton = new JButton("Calculate");
        JButton resetButton = new JButton("Reset");

        
        calculateButton.addActionListener(e -> {
            try {
                int hourlyWage = Integer.parseInt(wageField.getText().trim());
                int yearlySalary = hourlyWage * 40 * 50;
                salaryField.setText(String.valueOf(yearlySalary));
            } catch (NumberFormatException ex) {
                salaryField.setText("Invalid input");
            }
        });

  
        resetButton.addActionListener(e -> {
            wageField.setText("0");
            salaryField.setText("0");
        });

     
        JFrame topFrame = new JFrame("Salary Calculator");
        topFrame.setLayout(new GridBagLayout());
        GridBagConstraints c = new GridBagConstraints();
        c.insets = new Insets(5, 5, 5, 5);

        c.gridx = 0; c.gridy = 0;
        topFrame.add(wageLabel, c);
        c.gridx = 1;
        topFrame.add(wageField, c);

        c.gridx = 0; c.gridy = 1;
        topFrame.add(salaryLabel, c);
        c.gridx = 1;
        topFrame.add(salaryField, c);

        c.gridx = 0; c.gridy = 2;
        topFrame.add(calculateButton, c);
        c.gridx = 1;
        topFrame.add(resetButton, c);

        topFrame.pack();
        topFrame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        topFrame.setVisible(true);
    }
}



Check Your Understanding
1) A JButton is a clickable button. It lets the user trigger an action, such as calculating or resetting.
2) It registers code to run whenever the button is clicked. Without a listener, clicking the button does nothing.
3) The salary is a calculated result, so the user should only read it. setEditable(false) stops the user from typing over it.
4) It converts the text typed in the hourly wage field into an int so the program can do math with it.
5) yearlySalary = hourlyWage * 40 * 50, which is hourly wage × 40 hours per week × 50 weeks per year.
6) GridBagLayout arranges components in a grid of rows and columns. GridBagConstraints sets where each component goes (gridx, gridy) and its spacing (insets).
7) Each button does a different job. Reset needs its own listener to set both fields back to their starting values, separate from Calculate.
8) Integer.parseInt() would throw a NumberFormatException. This program catches it and shows "Invalid input" in the salary field instead of crashing.



