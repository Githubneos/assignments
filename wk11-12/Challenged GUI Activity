import java.awt.GridBagConstraints;
import java.awt.GridBagLayout;
import java.awt.Insets;
import javax.swing.JFrame;
import javax.swing.JLabel;
import javax.swing.JSpinner;
import javax.swing.JTextField;
import javax.swing.SpinnerNumberModel;
import javax.swing.event.ChangeEvent;
import javax.swing.event.ChangeListener;

public class DogYearsFrame extends JFrame implements ChangeListener {
    private JSpinner yearsSpinner;
    private JTextField ageHumanField;
    private JLabel yearsLabel;
    private JLabel ageHumanLabel;

    DogYearsFrame() {
        double initYear;
        double minYear;
        double maxYear;
        double stepVal;

        initYear = 0.0;
        minYear = 0.0;
        maxYear = 30.0;
        stepVal = 0.5;

        GridBagConstraints layoutConst = null;

        SpinnerNumberModel spinnerModel = null;

        setTitle("Dog's age in human years");

        yearsLabel = new JLabel("Select dog's age (years):");
        ageHumanLabel = new JLabel("Age (human years):");

        spinnerModel = new SpinnerNumberModel(initYear, minYear, maxYear, stepVal);
        yearsSpinner = new JSpinner(spinnerModel);
        yearsSpinner.addChangeListener(this);

        ageHumanField = new JTextField(15);
        ageHumanField.setEditable(false);
        ageHumanField.setText("0 - 15");

        setLayout(new GridBagLayout());

        layoutConst = new GridBagConstraints();
        layoutConst.insets = new Insets(10, 10, 10, 1);
        layoutConst.anchor = GridBagConstraints.LINE_END;
        layoutConst.gridx = 0;
        layoutConst.gridy = 0;
        add(yearsLabel, layoutConst);

        layoutConst = new GridBagConstraints();
        layoutConst.insets = new Insets(10, 1, 10, 10);
        layoutConst.fill = GridBagConstraints.HORIZONTAL;
        layoutConst.gridx = 1;
        layoutConst.gridy = 0;
        add(yearsSpinner, layoutConst);

        layoutConst = new GridBagConstraints();
        layoutConst.insets = new Insets(10, 10, 10, 1);
        layoutConst.anchor = GridBagConstraints.LINE_END;
        layoutConst.gridx = 0;
        layoutConst.gridy = 1;
        add(ageHumanLabel, layoutConst);

        layoutConst = new GridBagConstraints();
        layoutConst.insets = new Insets(10, 1, 10, 10);
        layoutConst.fill = GridBagConstraints.HORIZONTAL;
        layoutConst.gridx = 1;
        layoutConst.gridy = 1;
        add(ageHumanField, layoutConst);
    }

    @Override
    public void stateChanged(ChangeEvent event) {
        Double dogAgeYears;
        int halfYears;

        dogAgeYears = (Double) yearsSpinner.getValue();
        halfYears = (int) (dogAgeYears * 2);

        switch (halfYears) {
            case 0:
                ageHumanField.setText("0 - 15");
                break;

            case 1:
                ageHumanField.setText("7.5");
                break;

            case 2:
                ageHumanField.setText("15");
                break;

            case 3:
                ageHumanField.setText("19.5");
                break;

            case 4:
                ageHumanField.setText("24");
                break;

            case 5:
                ageHumanField.setText("26");
                break;

            case 6:
                ageHumanField.setText("28");
                break;

            case 7:
                ageHumanField.setText("30");
                break;

            case 8:
                ageHumanField.setText("32");
                break;

            case 9:
                ageHumanField.setText("34.5");
                break;

            case 10:
                ageHumanField.setText("37");
                break;

            case 11:
                ageHumanField.setText("39.5");
                break;

            case 12:
                ageHumanField.setText("42");
                break;

            case 13:
                ageHumanField.setText("44.5");
                break;

            case 14:
                ageHumanField.setText("47");
                break;

            case 15:
                ageHumanField.setText("49.5");
                break;

            case 16:
                ageHumanField.setText("52");
                break;

            case 17:
                ageHumanField.setText("54.5");
                break;

            case 18:
                ageHumanField.setText("57");
                break;

            case 19:
                ageHumanField.setText("59.5");
                break;

            case 20:
                ageHumanField.setText("62");
                break;

            case 21:
                ageHumanField.setText("64.5");
                break;

            case 22:
                ageHumanField.setText("67");
                break;

            case 23:
                ageHumanField.setText("69.5");
                break;

            case 24:
                ageHumanField.setText("72");
                break;

            case 25:
                ageHumanField.setText("74.5");
                break;

            case 26:
                ageHumanField.setText("77");
                break;

            case 27:
                ageHumanField.setText("79.5");
                break;

            case 28:
                ageHumanField.setText("82");
                break;

            default:
                ageHumanField.setText("That's a long life!");
        }
    }

    public static void main(String[] args) {
        DogYearsFrame myFrame = new DogYearsFrame();

        myFrame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        myFrame.pack();
        myFrame.setVisible(true);
    }
}








Check Your Understanding
1) JSpinner lets the user pick a dog age by clicking up and down arrows or by typing a value. The program then reacts to the selected age.
2) It controls the spinner's data: the initial value, the minimum, the maximum, and the step size.
3) A step of 1 only moves the spinner between whole numbers (0, 1, 2, ...). A step of 0.5 lets it reach 0.5, 1.5, 2.5, and so on.
4) Once the model uses double values, getValue() returns a Double. Casting it to Integer would fail with a ClassCastException, and an int could not hold a value like 1.5 anyway.
5) The spinner's value changes, whether by clicking an arrow or typing a new value. This works because the class implements ChangeListener and registers itself with yearsSpinner.addChangeListener(this).
6) Take the average of the human ages at the whole years on each side. Age 1 is 15 and age 2 is 24, so 1.5 years is (15 + 24) / 2 = 19.5 human years.
7) The field shows a calculated result, so the user should only read it. Making it non-editable stops the user from typing over the answer.
8) It arranges the labels, spinner, and text field in a grid of rows and columns. GridBagConstraints sets each component's cell (gridx, gridy), spacing (insets), and alignment or stretching (anchor, fill).
